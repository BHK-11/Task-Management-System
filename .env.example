# Spring Boot does not load .env files automatically. Set these in your shell or deployment environment.
DB_URL=jdbc:postgresql://localhost:5432/taskos
DB_USERNAME=taskos
DB_PASSWORD=replace-with-your-local-postgresql-password
SERVER_PORT=8080

# Optional for the PostgreSQL integration test (must point to an isolated test database).
TASKOS_TEST_DB_URL=jdbc:postgresql://localhost:5432/taskos_test

# AI provider credentials belong only in the private AI service environment.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional mode-specific targets use provider/model-id (for example: openai/model-id).
# Unset modes use TASKOS_AI_DEFAULT_TARGET or the configured OPENAI_MODEL.
TASKOS_AI_DEFAULT_PROVIDER=openai
TASKOS_AI_DEFAULT_TARGET=
TASKOS_AI_AUTO_TARGET=
TASKOS_AI_FAST_TARGET=
TASKOS_AI_BALANCED_TARGET=
TASKOS_AI_QUALITY_TARGET=
TASKOS_AI_ECONOMICAL_TARGET=
# Ordered provider/model targets; fallback is available only after the user opts in.
TASKOS_AI_FALLBACK_TARGETS=

# Optional Phase 18 read-only browser worker. Use the same private token in both processes.
TASKOS_BROWSER_SERVICE_URL=http://127.0.0.1:8091
TASKOS_BROWSER_SERVICE_TOKEN=
# Set TASKOS_BROWSER_ALLOWED_ORIGINS only in the private browser-worker process; exact HTTPS origins, comma-separated.
